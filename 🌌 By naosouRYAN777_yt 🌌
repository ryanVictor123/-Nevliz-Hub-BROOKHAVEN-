local function SafeExecute(codeUrl)
    local downloadSuccess, code = pcall(function()
        return game:HttpGet(codeUrl, true)
    end)

    if not downloadSuccess then
        warn("[Anti-Crash] Falha ao baixar o script: " .. tostring(code))
        return false
    end

    local compileSuccess, compiledFunc = pcall(loadstring, code)
    if not compileSuccess or type(compiledFunc) ~= "function" then
        warn("[Anti-Crash] Erro de compilação ou script inválido.")
        return false
    end

    task.spawn(function()
        local execSuccess, err = pcall(compiledFunc)
        if not execSuccess then
            warn("[Anti-Crash] Erro de execução: " .. tostring(err))
        end
    end)

    return true
end

